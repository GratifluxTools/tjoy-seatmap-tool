       </p>\n                                                            </a>\n                                                        </li>\n                                                                                                            <li class=\"normal text-center\">\n                                                            <a class=\"calendar-item d-block \" data-date=\"2026-11-20\">\n                                                                <p class=\"font-weight-bold calendar-item-day\">\n                                                                    <small class=\"font-weight-bold\">11/</small>20                                                                    <small class=\"font-weight-bold ml-1\">(金)</small>\n                                                                </p>\n                                                                <p class=\"calendar-item-content d-block mb-0\">\n                                                                                                                                    </p>\n                                                            </a>\n                                                        </li>\n                                                                                                            <li class=\"normal text-center\">\n                                                            <a class=\"calendar-item d-block \" data-date=\"2026-12-04\">\n                                                                <p class=\"font-weight-bold calendar-item-day\">\n                                                                    <small class=\"font-weight-bold\">12/</small>4                                                                    <small class=\"font-weight-bold ml-1\">(金)</small>\n                                                                </p>\n                                                                <p class=\"calendar-item-content d-block mb-0\">\n                                                                                                                                    </p>\n                                                            </a>\n                                                        </li>\n                                                                                                            <li class=\"normal text-center\">\n                                                            <a class=\"calendar-item d-block \" data-date=\"2026-12-05\">\n                                                                <p class=\"font-weight-bold calendar-item-day\">\n                                                                    <small class=\"font-weight-bold\">12/</small>5                                                                    <small class=\"font-weight-bold ml-1\">(土)</small>\n                                                                </p>\n                                                                <p class=\"calendar-item-content d-block mb-0\">\n                                                                                                                                    </p>\n                                                            </a>\n                                                        </li>\n                                                                                                            <li class=\"normal text-center\">\n                                                            <a class=\"calendar-item d-block \" data-date=\"2026-12-06\">\n                                                                <p class=\"font-weight-bold calendar-item-day\">\n                                                                    <small class=\"font-weight-bold\">12/</small>6                                                                    <small class=\"font-weight-bold ml-1\">(日)</small>\n                                                                </p>\n                                                                <p class=\"calendar-item-content d-block mb-0\">\n                                                                                                                                    </p>\n                                                            </a>\n                                                        </li>\n                                                                                                    </ul>\n                                            </div>\n                                        </div>\n                                        <ul class=\"d-flex flex-wrap mb-0\" id=\"schedule-tab\"></ul>\n                                                                    </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <input type=\"hidden\" name=\"\" id=\"csrfToken\" value=\"e6e395f7e5bd544059bd3f952e5f8a1e43eddd2fbf22fa42eeb9cac0bcb443deedef8dbdea8acb5920108b106b8eabb019cbf0d916ffc1fe68e925c9654240e1\"/>    <input type=\"hidden\" name=\"\" id=\"userLogin\" value=\"false\"/>    <input type=\"hidden\" name=\"\" id=\"seatMax\" value=\"5\"/>    <input type=\"hidden\" name=\"\" id=\"seatDouble\" value=\"false\"/>    <input type=\"hidden\" name=\"\" id=\"seatTriple\" value=\"false\"/>    <input type=\"hidden\" name=\"\" id=\"seatLength\" value=\"0\"/>    <input type=\"hidden\" name=\"\" id=\"seatLengthMoney\" value=\"0\"/>    <input type=\"hidden\" name=\"\" id=\"seatAddChange\" value=\"0\"/>    <input type=\"hidden\" name=\"\" id=\"seatArr\" value=\"\"/>\n\n    <form method=\"post\" accept-charset=\"utf-8\" id=\"form\" action=\"https://tjoy.jp/t-joy_emiterrace_tokorozawa/reservation/choice_ticket\"><div style=\"display:none;\"><input type=\"hidden\" name=\"_method\" value=\"POST\"/><input type=\"hidden\" name=\"_csrfToken\" autocomplete=\"off\" value=\"e6e395f7e5bd544059bd3f952e5f8a1e43eddd2fbf22fa42eeb9cac0bcb443deedef8dbdea8acb5920108b106b8eabb019cbf0d916ffc1fe68e925c9654240e1\"/></div> \n\n        <input type=\"hidden\" name=\"scheduleId\" id=\"scheduleId\" value=\"65881\"/>        <input type=\"hidden\" name=\"theaterId\" id=\"theaterId\" value=\"200\"/>\n    </form>\n\n</div>\n\n<!--modal operation-->\n<div class=\"modal operation-modal main-modal\">\n    <div class=\"vertical-alignment-helper\">\n        <div class=\"modal-dialog vertical-align-center\">\n            <div class=\"modal-content\">\n                <!-- Modal header -->\n                <div class=\"modal-header\">\n                    <p class=\"modal-title font-weight-bold text-center mx-auto\">操作説明</p>\n                </div>\n                <!-- Modal body -->\n                <div class=\"modal-body\">\n                    <div class=\"d-flex operation-item d-md-none d-lg-none d-xl-none\">\n                        <div class=\"operation-img\">\n                            <img class=\"img-fluid\" src=\"/img/front/images/seat/img_operation1.jpg\" alt=\"座席表をタップすると拡大します。\">\n                        </div>\n                        <div class=\"operation-info\">座席表をタップすると拡大します。</div>\n                    </div>\n\n                    <div class=\"d-flex operation-item\">\n                        <div class=\"operation-img\">\n                            <img class=\"img-fluid d-md-none d-lg-none d-xl-none\" src=\"/img/front/images/seat/img_operation2.jpg\" alt=\"座席表が拡大した状態で座席をタップし、選択してください。\">\n                            <img class=\"img-fluid d-none d-md-block d-lg-block d-xl-block\" src=\"/img/front/images/seat/img_operation2_pc.jpg\" alt=\"座席をクリックし、選択してください。\">\n                        </div>\n                        <div class=\"operation-info d-md-none d-lg-none d-xl-none\">座席表が拡大した状態で座席をタップし、選択してください。</div>\n                        <div class=\"operation-info d-none d-md-block d-lg-block d-xl-block\">座席をクリックし、選択してください。</div>\n                    </div>\n                    <div class=\"d-flex operation-item\">\n                        <div class=\"operation-img\">\n                            <img class=\"img-fluid d-md-none d-lg-none d-xl-none\" src=\"/img/front/images/seat/img_operation3.jpg\" alt=\"選択中の座席をクリックすると選択が解除されます。\">\n                            <img class=\"img-fluid d-none d-md-block d-lg-block d-xl-block\" src=\"/img/front/images/seat/img_operation3_pc.jpg\" alt=\"選択中の座席をクリックすると選択が解除されます。\">\n                        </div>\n                        <div class=\"operation-info\">選択中の座席をクリックすると選択が解除されます。</div>\n                    </div>\n                </div>\n                <!-- Modal footer -->\n                <div class=\"modal-footer\">\n                    <div class=\"btn-list justify-content-center w-100\">\n                        <button type=\"button\" class=\"btn btn-primary w-100\" data-dismiss=\"modal\">閉じる</button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<!--modal operation-->\n\n<!--pair sheet modal-->\n<div class=\"modal pair-sheet-modal main-modal\">\n    <div class=\"vertical-alignment-helper\">\n        <div class=\"modal-dialog vertical-align-center\">\n            <div class=\"modal-content\">\n                <!-- Modal header -->\n                <div class=\"modal-header\">\n                    <p class=\"modal-title font-weight-bold text-center mx-auto\">ペアシート</p>\n                </div>\n                <!-- Modal body -->\n                <div class=\"modal-body\">\n                                            <p>\n                        <img class=\"img-fluid d-block mx-auto\" src=\"/img/front/images/seat/img_pairsheet3.jpg\" alt=\"\">\n                        </p>\n                        <div>\n                            ソファに座っているようなゆったりとした座り心地の二人掛けシートです。\n                            <br>区切られた空間は、カップル・ファミリーでご鑑賞のお客様におすすめです。\n                        </div>\n                        <span class=\"d-block mt-3 mb-4\">※追加料金はかかりません。</span>\n                                    </div>\n                <!-- Modal footer -->\n                <div class=\"modal-footer\">\n                    <div class=\"btn-list justify-content-center w-100\">\n                        <button type=\"button\" class=\"btn btn-primary w-100\" data-dismiss=\"modal\">閉じる</button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<!--pair sheet modal-->\n\n<!--trio seat modal-->\n<div class=\"modal trio-seat-modal main-modal\">\n    <div class=\"vertical-alignment-helper\">\n        <div class=\"modal-dialog vertical-align-center\">\n            <div class=\"modal-content\">\n                <!-- Modal header -->\n                <div class=\"modal-header\">\n                    <p class=\"modal-title font-weight-bold text-center mx-auto\">トリオシート</p>\n                </div>\n                <!-- Modal body -->\n                <div class=\"modal-body\">\n                    <p>\n                        <img class=\"img-fluid d-block mx-auto\" src=\"/img/front/images/seat/img_trioseat.jpg\" alt=\"\">\n                    </p>\n                    <div>\n                        プライベート感を高めたボックス型の三人掛けシートです。\n                        <br>区切られた空間は、グループ・ファミリーでご鑑賞のお客様におすすめです。\n                    </div>\n                    <span class=\"d-block mt-3 mb-4\">※追加料金はかかりません。</span>\n                </div>\n                <!-- Modal footer -->\n                <div class=\"modal-footer\">\n                    <div class=\"btn-list justify-content-center w-100\">\n                        <button type=\"button\" class=\"btn btn-primary w-100\" data-dismiss=\"modal\">閉じる</button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<!--trio seat modal-->\n\n<!--premier seat modal-->\n<div class=\"modal premier-seat-modal main-modal\">\n    <div class=\"vertical-alignment-helper\">\n        <div class=\"modal-dialog vertical-align-center\">\n            <div class=\"modal-content\">\n                <!-- Modal header -->\n                <div class=\"modal-header\">\n                    <p class=\"modal-title font-weight-bold text-center mx-auto\">プレミアシート</p>\n                </div>\n                <!-- Modal body -->\n                <div class=\"modal-body\">\n                                            <p>\n                            <img class=\"img-fluid d-block mx-auto\" src=\"/img/front/images/seat/img_premierseat.jpg\" alt=\"\">\n                        </p>\n                        <div>\n                            高級感あふれる木目調のデザイン、座り心地のよい革張のシートは、疲れやストレスを感じさせません。\n                        </div>\n                        <span class=\"d-block mt-3 mb-4\">※追加料金あり</span>\n                                    </div>\n                <!-- Modal footer -->\n                <div class=\"modal-footer\">\n                    <div class=\"btn-list justify-content-center w-100\">\n                        <button type=\"button\" class=\"btn btn-primary w-100\" data-dismiss=\"modal\">閉じる</button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<!--premier seat modal-->\n\n<!--executive seat modal-->\n<div class=\"modal executive-seat-modal main-modal\">\n    <div class=\"vertical-alignment-helper\">\n        <div class=\"modal-dialog vertical-align-center\">\n            <div class=\"modal-content\">\n                <!-- Modal header -->\n                <div class=\"modal-header\">\n                    <p class=\"modal-title font-weight-bold text-center mx-auto\">エグゼクティブシート</p>\n                </div>\n                <!-- Modal body -->\n                <div class=\"modal-body\">\n                    <p>\n                        <img class=\"img-fluid d-block mx-auto\" src=\"/img/front/images/seat/img_exectiveseat.jpg\" alt=\"\">\n                    </p>\n                    <div>人間工学に基づいたデザインとクッション部の二重構造により、柔らかく体が包まれるような贅沢な座り心地を体感いただけます。\n                    </div>\n                    <span class=\"d-block mt-3 mb-4\">※追加料金あり</span>\n                </div>\n                <!-- Modal footer -->\n                <div class=\"modal-footer\">\n                    <div class=\"btn-list justify-content-center w-100\">\n                        <button type=\"button\" class=\"btn btn-primary w-100\" data-dismiss=\"modal\">閉じる</button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<!--executive seat modal-->\n\n<!--sofa-seat-modal-->\n<div class=\"modal sofa-seat-modal main-modal\">\n    <div class=\"vertical-alignment-helper\">\n        <div class=\"modal-dialog vertical-align-center\">\n            <div class=\"modal-content\">\n                <!-- Modal header -->\n                <div class=\"modal-header\">\n                    <p class=\"modal-title font-weight-bold text-center mx-auto\">プレミアムソファシート</p>\n                </div>\n                <!-- Modal body -->\n                <div class=\"modal-body\">\n                    <p>\n                        <img class=\"img-fluid d-block mx-auto\" src=\"/img/front/images/seat/img_pairsheet2.jpg\" alt=\"\">\n                    </p>\n                    <div>リクライニング＆フットレストプレミアムシートを設置！<br>ゆったりとくつろげるソファ席をご用意しました。\n                    </div>\n                    <div class=\"mt-3\">お一人様でも、カップルでも、親子でも楽しめる、まさにプレミアム！なシートです。あなたの特別な日に、いかがですか？</div>\n                    <span class=\"mt-3 d-block mb-4\">※鑑賞料金とは別途に追加料金がかかります。</span>\n                </div>\n                <!-- Modal footer -->\n                <div class=\"modal-footer\">\n                    <div class=\"btn-list justify-content-center w-100\">\n                        <button type=\"button\" class=\"btn btn-primary w-100\" data-dismiss=\"modal\">閉じる</button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<!--sofa-seat-modal-->\n\n<!--reclining seat modal-->\n<div class=\"modal reclining-seat-modal main-modal\">\n    <div class=\"vertical-alignment-helper\">\n        <div class=\"modal-dialog vertical-align-center\">\n            <div class=\"modal-content\">\n                <!-- Modal header -->\n                <div class=\"modal-header\">\n                    <p class=\"modal-title font-weight-bold text-center mx-auto\">リクライニングシート</p>\n                </div>\n                <!-- Modal body -->\n                <div class=\"modal-body\">\n                    <p>\n                        <img class=\"img-fluid d-block mx-auto\" src=\"/img/front/images/seat/img_recliningseat.jpg\" alt=\"\">\n                    </p>\n                    <div>\n                        シアターの最前列に配置され、本シート独自の臨場感や迫力が体感できます。\n                        <br>寝そべるように体重をかけるだけで、リラックスした体勢で映画の世界に没入することができます。\n                    </div>\n                    <span class=\"d-block mt-3 mb-4\">※追加料金あり</span>\n                </div>\n                <!-- Modal footer -->\n                <div class=\"modal-footer\">\n                    <div class=\"btn-list justify-content-center w-100\">\n                        <button type=\"button\" class=\"btn btn-primary w-100\" data-dismiss=\"modal\">閉じる</button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<!--reclining seat modal-->\n\n<!--counter seat modal-->\n<div class=\"modal counter-seat-modal main-modal\">\n    <div class=\"vertical-alignment-helper\">\n        <div class=\"modal-dialog vertical-align-center\">\n            <div class=\"modal-content\">\n                <!-- Modal header -->\n                <div class=\"modal-header\">\n                    <p class=\"modal-title font-weight-bold text-center mx-auto\">カウンターシート</p>\n                </div>\n                <!-- Modal body -->\n                <div class=\"modal-body pb-4\">\n                    <p>\n                        <img class=\"img-fluid d-block mx-auto\" src=\"/img/front/images/seat/img_counterseat.jpg\" alt=\"\">\n                    </p>\n                    <div>\n                        シアターの最後列に配置された、座席とカウンターを合わせたシートです。\n                        <br>隣席との幅が他座席より広く、飲み物や軽食などを楽しみながらご利用いただけます。\n                    </div>\n                    <span class=\"d-block mt-3\">※追加料金あり</span>\n                                    </div>\n                <!-- Modal footer -->\n                <div class=\"modal-footer\">\n                    <div class=\"btn-list justify-content-center w-100\">\n                        <button type=\"button\" class=\"btn btn-primary w-100\" data-dismiss=\"modal\">閉じる</button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<!--counter seat modal-->\n\n<div class=\"modal modal-container\" id=\"myModal1\">\n    <div class=\"modal-dialog modal-dialog-centered\">\n        <div class=\"modal-content\">\n            <!-- Modal header -->\n            <div class=\"modal-header\">\n                <p class=\"modal-title font-weight-bold text-center mx-auto\">ご案内</p>\n            </div>\n            <!-- Modal body -->\n            <div class=\"modal-body\">\n                <p>ご利用の環境では、クレジットカードがご利用できません。<br>\n                    推奨環境をご確認の上、ご購入手続きをお願い致します。<br>\n\n                    オンライン予約システム KINEZO をご利用していただくためには下記のブラウザソフトを推奨いたします。<br>\n                    Microsoft Internet Explorer 9.x 、10.x 、11.x<br>\n                    また、下記のブラウザソフトもご利用いただけます。<br>\n                    Mozilla FireFox 28以上<br>\n\n                    ※上記以外の環境では、ご利用頂けない場合がございます。<br>\n                    ※クレジットカード決済ご利用の場合はTLS1.2が有効である必要がございます。<br>\n                </p>\n            </div>\n            <!-- Modal footer -->\n            <div class=\"modal-footer\">\n                <div class=\"btn-list justify-content-beetween w-100\">\n                    <button type=\"button\" class=\"btn btn-danger w-100\" data-dismiss=\"modal\">OK</button>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<button style=\"display: none;\" class=\"btn btn-outline-dark bg-white rounded-0 btn-film-content\" data-toggle=\"modal\" id=\"myModalTlsEventButton\" data-target=\"#myModal1\"></button>\n\n<div class=\"modal modal-container\" id=\"myModal2\">\n    <div class=\"modal-dialog modal-dialog-centered\">\n        <div class=\"modal-content\">\n            <!-- Modal header -->\n            <div class=\"modal-header\">\n                <p class=\"modal-title font-weight-bold text-center mx-auto\">ご案内</p>\n            </div>\n            <!-- Modal body -->\n            <div class=\"modal-body\">\n                <p>ご利用の環境では、クレジットカードがご利用できません。<br>\n                    推奨環境をご確認の上、ご購入手続きをお願い致します。<br>\n\n                    オンライン予約システム KINEZO をご利用していただくためには下記のブラウザソフトを推奨いたします。<br>\n                    Microsoft Internet Explorer 9.x 、10.x 、11.x<br>\n                    また、下記のブラウザソフトもご利用いただけます。<br>\n                    Mozilla FireFox 28以上<br>\n\n                    ※上記以外の環境では、ご利用頂けない場合がございます。<br>\n                    ※クレジットカード決済ご利用の場合はTLS1.2が有効である必要がございます。<br>\n                </p>\n            </div>\n            <!-- Modal footer -->\n            <div class=\"modal-footer\">\n                <div class=\"btn-list justify-content-beetween w-100\">\n                    <button type=\"button\" class=\"btn btn-danger w-100\" data-dismiss=\"modal\">OK</button>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<button style=\"display: none;\" class=\"btn btn-outline-dark bg-white rounded-0 btn-film-content\" data-toggle=\"modal\" id=\"myModalTlsButton\" data-target=\"#myModal2\"></button>\n\n<div class=\"modal modal-3 main-modal\" id=\"myModal3\">\n    <div class=\"modal-dialog modal-dialog-centered\">\n        <div class=\"modal-content\">\n            <!-- Modal header -->\n            <div class=\"modal-header\">\n                <p class=\"modal-title font-weight-bold text-center mx-auto\">ご案内</p>\n            </div>\n            <!-- Modal body -->\n            <div class=\"modal-body pb-0\">\n                <p class=\"mb-0\">本上映回はMX4D上映となります。映画のシーンに合わせ客席が動くほかさまざまな特殊効果をお楽しみいただけます。</p>\n                <p class=\"font-weight-bold mt-4 mb-0\">■お客様の安全に考慮し、次のお客様はご鑑賞いただけません。</p>\n                <ul>\n                    <li class=\"pl-1\">・ 身長が100cm未満の方</li>\n                    <li class=\"pl-1\">・ 妊娠中の方、またはその可能性がある方</li>\n                    <li class=\"pl-1\">・ 体調がすぐれない方、乗り物酔いしやすい方、泥酔している方</li>\n                    <li class=\"pl-1\">・ 自立歩行が困難な方、心臓に不安のある方、首・背中・腰などに障がいのある方</li>\n                </ul>\n                <p class=\"mb-0 mt-4\">※なお、ご飲食によるこぼれや汚れ、怪我が発生した場合、特殊効果による衣服の濡れ、身体に不調をきたした場合など、当劇場では責任を負いかねますのでご了承ください。</p>\n            </div>\n            <!-- Modal footer -->\n            <div class=\"modal-footer pt-0 mt-5\">\n                <div class=\"btn-list justify-content-beetween w-100\">\n                    <a href=\"javascript:void(0);\" class=\"btn btn-primary\" role=\"button\" data-dismiss=\"modal\">キャンセル</a>\n                    <button id=\"mx4dOkButton\" type=\"button\" class=\"btn btn-danger\" data-dismiss=\"modal\">OK</button>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<button style=\"display: none;\" class=\"btn btn-outline-dark bg-white rounded-0 btn-film-content\" data-toggle=\"modal\" id=\"myModal4DButton\" data-target=\"#myModal3\"></button>\n\n<div class=\"modal modal-3 main-modal\" id=\"myModal13\">\n    <div class=\"modal-dialog modal-dialog-centered\">\n        <div class=\"modal-content\">\n            <!-- Modal header -->\n            <div class=\"modal-header\">\n                <p class=\"modal-title font-weight-bold text-center mx-auto\">ご案内</p>\n            </div>\n            <!-- Modal body -->\n            <div class=\"modal-body pb-0\">\n                <p class=\"mb-0\">\n                                        本上映回はIMAX®レーザー3Dの上映です。<br>\n                    ご鑑賞には専用メガネが必要です。<br><br>\n                    ※お持ちでないお客様は券種選択の際に「IMAXメガネ購入」をご選択ください。ご入場時にお渡しいたします。<br>\n                    ※他館にてご購入いただいたIMAX®デジタル3D専用メガネはご使用いただけません。\n                                    </p>\n            </div>\n            <!-- Modal footer -->\n            <div class=\"modal-footer pt-0 mt-5\">\n                <div class=\"btn-list justify-content-beetween w-100\">\n                    <a href=\"javascript:void(0);\" class=\"btn btn-primary\" role=\"button\" data-dismiss=\"modal\">キャンセル</a>\n                    <button id=\"imaxOkButton\" type=\"button\" class=\"btn btn-danger\" data-dismiss=\"modal\">OK</button>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<button style=\"display: none;\" class=\"btn btn-outline-dark bg-white rounded-0 btn-film-content\" data-toggle=\"modal\" id=\"myModalImaxButton\" data-target=\"#myModal13\"></button>\n\n<div class=\"modal modal-container\" id=\"myModal4\">\n    <div class=\"modal-dialog modal-dialog-centered\">\n        <div class=\"modal-content\">\n            <!-- Modal header -->\n            <div class=\"modal-header\">\n                <p class=\"modal-title font-weight-bold text-center mx-auto\">ご案内</p>\n            </div>\n            <!-- Modal body -->\n            <div class=\"modal-body\">\n                <p class=\"modal-error text-center mx-auto\">\n                    この上映回は窓口販売のみのためWeb予約できません。<br/>\n                    お手数ですが窓口をご利用ください。\n                </p>\n            </div>\n            <!-- Modal footer -->\n            <div class=\"modal-footer\">\n                <div class=\"btn-list justify-content-beetween w-100\">\n                    <button type=\"button\" class=\"btn btn-danger w-100\" data-dismiss=\"modal\">閉じる</button>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<button style=\"display: none;\" class=\"btn btn-outline-dark bg-white rounded-0 btn-film-content\" data-toggle=\"modal\" id=\"myModalSellRouteButton\" data-target=\"#myModal4\"></button>\n\n<div class=\"modal overbooked-modal main-modal\" id=\"myModal5\">\n    <div class=\"vertical-alignment-helper\">\n        <div class=\"modal-dialog vertical-align-center\">\n            <div class=\"modal-content\">\n                <!-- Modal header -->\n                <div class=\"modal-header\">\n                    <p class=\"modal-title font-weight-bold text-center mx-auto\">あとから決済が選択できません</p>\n                </div>\n                <!-- Modal body -->\n                <div class=\"modal-body\">\n                    <p class=\"text-center\"><span class=\"txt-note\">同じ会員情報、同じ上映回での座席選択上限数を超えています。</span><br>\n                        [あとから決済]以外の購入方法を選択してください。</p>\n                </div>\n                <!-- Modal footer -->\n                <div class=\"modal-footer\">\n                    <div class=\"btn-list justify-content-beetween w-100\">\n                        <a class=\"btn btn-primary\" role=\"button\" data-dismiss=\"modal\">座席選択に戻る</a>\n                        <button type=\"button\" class=\"btn btn-secondary-dark seatSubmit\">次に進む</button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<button style=\"display: none;\" class=\"btn btn-outline-dark bg-white rounded-0 btn-film-content\" data-toggle=\"modal\" id=\"myModalSeat10Button\" data-target=\"#myModal5\"></button>\n\n<div class=\"modal modal-4 main-modal\" id=\"myModal6\">\n    <div class=\"modal-dialog modal-dialog-centered\">\n        <div class=\"modal-content\" style=\"overflow:auto\">\n            <!-- Modal header -->\n            <div class=\"modal-header\">\n                <p class=\"modal-title font-weight-bold text-center mx-auto\">ご案内</p>\n            </div>\n            <!-- Modal body -->\n            <div class=\"modal-body pb-0\" style=\"overflow:visible\">\n                <p class=\"mb-0 text-center\">\n                    KINEZOアカウントでログインするとご利用いただけます。<br/>はじめての方は会員登録を行うことでご利用いただけます。\n                </p>\n\n            </div>\n            <!-- Modal footer -->\n            <div class=\"modal-footer pt-0 mt-5\" >\n                <div class=\"btn-list flex-column w-100\">\n\n                    <span style=\"display:block;\" class=\"w-100 mb-3\">KINEZO会員の方</span>\n\n\n                    <button type=\"button\" class=\"btn btn-danger mb-3 mx-auto amazon-button-size\" onclick=\"window.location.href = 'https://tjoy.jp/t-joy_emiterrace_tokorozawa/login'\">KINEZOアカウントでログイン</button>\n\n                    <hr class=\"w-100 seat_choice_login\">\n\n                    <span style=\"display:block;\" class=\"w-100 mt-2 mb-2\">または、Amazonアカウントをお持ちの方</span>\n\n\n                    <div class=\"amazon-button-size mx-auto\" style=\"width:312px;\">\n                        <div id=\"AmazonPayButton\" style=\"width:312px; display: block;\" class=\"mx-auto\"></div>\n                    </div>\n                        \n                    <div class=\"w-100\" >\n\n                        <span style=\"display:block;width:312px;\" class=\"mt-2 text-left mx-auto amazon-button-size amazon-info\">アマゾンにご登録の情報を使って簡単にログインや</span>\n                        <span style=\"display:block;width:312px;\" class=\"mt-2 mb-3 text-left mx-auto amazon-button-size amazon-info\">会員登録ができます</span>\n\n                    </div>\n\n                    <hr class=\"w-100 seat_choice_login\">\n\n                    <span style=\"display:block;\" class=\"mb-3 mt-3 w-100\">はじめてご利用の方</span>\n\n                    <button type=\"button\" class=\"btn btn-danger mb-4 mx-auto amazon-button-size\" onclick=\"window.location.href = 'https://tjoy.jp/t-joy_emiterrace_tokorozawa/members/add'\">会員登録はこちら</button>\n                    <a class=\"btn btn-primary w-100\" role=\"button\" data-dismiss=\"modal\">キャンセル</a>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<button style=\"display: none;\" class=\"btn btn-outline-dark bg-white rounded-0 btn-film-content\" data-toggle=\"modal\" id=\"myModalLoginButton\" data-target=\"#myModal6\"></button>\n\n<div class=\"modal modal-2 main-modal\" id=\"myModal7\">\n    <div class=\"modal-dialog modal-dialog-centered\">\n        <div class=\"modal-content\">\n            <!-- Modal header -->\n            <div class=\"modal-header\">\n                <p class=\"modal-title font-weight-bold text-center mx-auto\">ご案内</p>\n            </div>\n            <!-- Modal body -->\n            <div class=\"modal-body\">\n                <p class=\"modal-error text-center mx-auto\">\n                    一度に予約できる座席は5席までです。\n                </p>\n            </div>\n            <!-- Modal footer -->\n            <div class=\"modal-footer\">\n                <div class=\"btn-list justify-content-beetween w-100\">\n                    <button type=\"button\" class=\"btn btn-danger w-100\" data-dismiss=\"modal\">閉じる</button>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<button style=\"display: none;\" class=\"btn btn-outline-dark bg-white rounded-0 btn-film-content\" data-toggle=\"modal\" id=\"myModalSeatMaxButton\" data-target=\"#myModal7\"></button>\n\n<div class=\"modal modal-2 main-modal\" id=\"myModal8\">\n    <div class=\"modal-dialog modal-dialog-centered\">\n        <div class=\"modal-content\">\n            <!-- Modal header -->\n            <div class=\"modal-header\">\n                <p class=\"modal-title font-weight-bold text-center mx-auto\">ご案内</p>\n            </div>\n            <!-- Modal body -->\n            <div class=\"modal-body\">\n                <p class=\"text-center mx-auto\">\n                    こちらのお座席は 2名様でご利用いただけるペアシートです。<br/>2名様分の料金が発生します。\n                </p>\n            </div>\n            <!-- Modal footer -->\n            <div class=\"modal-footer\">\n                <div class=\"btn-list justify-content-beetween w-100\">\n                    <button type=\"button\" class=\"btn btn-danger w-100\" data-dismiss=\"modal\">OK</button>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<button style=\"display: none;\" class=\"btn btn-outline-dark bg-white rounded-0 btn-film-content\" data-toggle=\"modal\" id=\"myModalSeatDoubleButton\" data-target=\"#myModal8\"></button>\n\n<div class=\"modal modal-2 main-modal\" id=\"myModal9\">\n    <div class=\"modal-dialog modal-dialog-centered\">\n        <div class=\"modal-content\">\n            <!-- Modal header -->\n            <div class=\"modal-header\">\n                <p class=\"modal-title font-weight-bold text-center mx-auto\">ご案内</p>\n            </div>\n            <!-- Modal body -->\n            <div class=\"modal-body\">\n                <p class=\"text-center mx-auto\">\n                    こちらのお座席は 3名様でご利用いただけるトリオシートです。<br/>3名様分の料金が発生します。\n                </p>\n            </div>\n            <!-- Modal footer -->\n            <div class=\"modal-footer\">\n                <div class=\"btn-list justify-content-beetween w-100\">\n                    <button type=\"button\" class=\"btn btn-danger w-100\" data-dismiss=\"modal\">OK</button>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<button style=\"display: none;\" class=\"btn btn-outline-dark bg-white rounded-0 btn-film-content\" data-toggle=\"modal\" id=\"myModalSeatTripleButton\" data-target=\"#myModal9\"></button>\n\n<div class=\"modal modal-3 main-modal\" id=\"myModal10\">\n    <div class=\"modal-dialog modal-dialog-centered\">\n        <div class=\"modal-content\">\n            <!-- Modal header -->\n            <div class=\"modal-header\">\n                <p class=\"modal-title font-weight-bold text-center mx-auto\">ご案内</p>\n            </div>\n            <!-- Modal body -->\n            <div class=\"modal-body pb-0\">\n                <div class=\"modal-error mx-auto\">\n                    <p class=\"text-center\">\n                        選択された座席の追加料金は総額<span id=\"seatFee\">***</span>円になります。\n                    </p>\n                    <p id=\"addChangeSeatNotes\" class=\"pt-3 d-none\">\n                        <span id=\"imax3dSeatNotes\" class=\"d-none\" style=\"display: block;\">\n                                                        本上映回はIMAX®レーザー3Dの上映です。<br>\n                            ご鑑賞には専用メガネが必要です。<br><br>\n                            ※お持ちでないお客様は券種選択の際に「IMAXメガネ購入」をご選択ください。ご入場の際にお渡しいたします。<br>\n                            ※他館にてご購入いただいたIMAX®デジタル3D専用メガネはご使用いただけません。\n                                                    </span>\n                        <span id=\"counterSeatNotes\" class=\"d-none\" style=\"display: block;\">\n                            ※カウンターシートはカウンターテーブルの構造上、目線の高さによりスクリーンの一部が見切れる場合がございます。<br>\n                            座席クッションシートの貸出も行っておりますのでご利用の際はスタッフまでお声掛けください。\n                        </span>\n                    </p>\n                </div>\n            </div>\n            <!-- Modal footer -->\n            <div class=\"modal-footer pt-0 mt-5\">\n                <div class=\"btn-list justify-content-beetween w-100\">\n                    <a href=\"javascript:void(0);>\" class=\"btn btn-primary\" role=\"button\" data-dismiss=\"modal\">キャンセル</a>\n                    <button type=\"button\" class=\"btn btn-danger seatSubmit\" data-dismiss=\"modal\">OK</button>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<button style=\"display: none;\" class=\"btn btn-outline-dark bg-white rounded-0 btn-film-content\" data-toggle=\"modal\" id=\"myModalAddChangeButton\" data-target=\"#myModal10\"></button>\n\n<div class=\"modal main-modal\" id=\"myModal15\">\n    <div class=\"vertical-alignment-helper\">\n        <div class=\"modal-dialog vertical-align-center\">\n            <div class=\"modal-content\">\n                <!-- Modal header -->\n                <div class=\"modal-header\">\n                    <p class=\"modal-title font-weight-bold text-center mx-auto\">仮押さえ中の座席があります</p>\n                </div>\n                <!-- Modal body -->\n                <div class=\"modal-body\">\n                                    </div>\n            </div>\n        </div>\n    </div>\n</div>\n<button style=\"display: none;\" class=\"btn btn-outline-dark bg-white rounded-0 btn-film-content\" data-toggle=\"modal\" id=\"myModalShowDupScreenButton\" data-target=\"#myModal15\"></button>\n\n<div class=\"modal modal-6 main-modal\" id=\"myModal11\">\n            <div class=\"vertical-alignment-helper\">\n            <div class=\"modal-dialog vertical-align-center\">\n                <div class=\"modal-content\">\n                    <!-- Modal header -->\n                    <div class=\"modal-header\">\n                        <p class=\"modal-title font-weight-bold text-center mx-auto\">ご予約　上映スケジュールのご確認</p>\n                    </div>\n                    <!-- Modal body -->\n                    <div class=\"modal-body\">\n                        <p class=\"text-center\">お客様がすでに予約されているスケジュールがございます。</p>\n                        <div class=\"seat-info mb-5 pb-1\">\n                            <p class=\"text-center mb-0 seat-info-ttl\">\n                                ご予約済みの座席情報\n                            </p>\n                            <div class=\"seat-info-content\">\n                                <p class=\"font-weight-bold mb-0 seat-info-content-ttl\"> ゴジラ-0.0</p>\n                                <p class=\"mb-0 seat-info-txt\">\n                                    <span>上映日 </span>11/12（木）08:50～11:20<br>\n                                    <span>劇場</span> T・ジョイ エミテラス所沢<br>\n                                    <span>シアター</span> ４                                </p>\n                            </div>\n                        </div>\n                        <div class=\"btn-list justify-content-beetween w-100\">\n                                                            <a class=\"btn btn-primary\" href=\"https://tjoy.jp/t-joy_emiterrace_tokorozawa/mypage/reserve\" role=\"button\">予約を確認する</a>\n                                                        <button type=\"button\" class=\"btn btn-secondary-dark\" data-dismiss=\"modal\">閉じる</button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n<button style=\"display: none;\" class=\"btn btn-outline-dark bg-white rounded-0 btn-film-content\" data-toggle=\"modal\" id=\"myModalShowDuplicateButton\" data-target=\"#myModal11\"></button>\n\n<div class=\"modal modal-6 main-modal\" id=\"myModal16\">\n            <div class=\"vertical-alignment-helper\">\n            <div class=\"modal-dialog vertical-align-center\">\n                <div class=\"modal-content\">\n                    <!-- Modal header -->\n                    <div class=\"modal-header\">\n                        <p class=\"modal-title font-weight-bold text-center mx-auto\">PayPay決済途中のご予約のご確認</p>\n                    </div>\n                    <!-- Modal body -->\n                    <div class=\"modal-body\">\n                        <p class=\"\">お客様がすでにPayPay決済を操作途中のご予約がございます。<br>予約の重複や支払いの混乱を避けるため、十分にご確認いただきますようお願い申し上げます。</p>\n                        <div class=\"seat-info mb-5 pb-1\">\n                            <p class=\"text-center mb-0 seat-info-ttl\">\n                                PayPay決済操作途中の座席情報\n                            </p>\n                            <div class=\"seat-info-content\">\n                                <p class=\"font-weight-bold mb-0 seat-info-content-ttl\"> ゴジラ-0.0</p>\n                                <p class=\"mb-0 seat-info-txt\">\n                                    <span>上映日 </span>11/12（木）08:50～11:20<br>\n                                    <span>劇場</span> T・ジョイ エミテラス所沢<br>\n                                    <span>シアター</span> ４                                </p>\n                            </div>\n                        </div>\n                        <div class=\"btn-list justify-content-center w-100\">\n                            <button type=\"button\" class=\"btn btn-secondary-dark\" data-dismiss=\"modal\">閉じる</button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n<button style=\"display: none;\" class=\"btn btn-outline-dark bg-white rounded-0 btn-film-content\" data-toggle=\"modal\" id=\"myModalShowAnotherPaymentButton\" data-target=\"#myModal16\"></button>\n\n<div class=\"modal modal-7 main-modal\" id=\"myModal14\">\n    <div class=\"vertical-alignment-helper\">\n        <div class=\"modal-dialog vertical-align-center\">\n            <div class=\"modal-content\">\n                <!-- Modal header -->\n                <div class=\"modal-header\">\n                    <p class=\"modal-title font-weight-bold text-center mx-auto\">エラー</p>\n                </div>\n                <!-- Modal body -->\n                <div class=\"modal-body\">\n                    <p class=\"seat-info-content\" id=\"messageCommon\"></p>\n                </div>\n                <div class=\"modal-footer\">\n                    <div class=\"btn-list justify-content-beetween w-100\">\n                        <button type=\"button\" class=\"btn btn-primary w-100\" data-dismiss=\"modal\">閉じる</button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n<div class=\"modal modal-3 main-modal\" id=\"myModal17\">\n    <div class=\"modal-dialog modal-dialog-centered\">\n        <div class=\"modal-content\">\n            <!-- Modal header -->\n            <div class=\"modal-header\">\n                <p class=\"modal-title font-weight-bold text-center mx-auto\">ご案内</p>\n            </div>\n            <!-- Modal body -->\n            <div class=\"modal-body pb-0\">\n                                <p class=\"mb-0\">自治体の定める条例に基づき、終了時刻が23時を過ぎる上映回には、18歳未満のお客様はご入場をお断りしております。保護者同伴であってもご入場いだだけません。</p>\n                            </div>\n            <!-- Modal footer -->\n            <div class=\"modal-footer pt-0 mt-5\">\n                <div class=\"btn-list justify-content-beetween w-100\">\n                                            <a href=\"https://tjoy.jp/t-joy_emiterrace_tokorozawa?date=2026-11-12#film-C4978000\" class=\"btn btn-primary\" role=\"button\">キャンセル</a>\n                                        <button type=\"button\" class=\"btn btn-danger\" data-dismiss=\"modal\">OK</button>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<button style=\"display: none;\" class=\"btn btn-outline-dark bg-white rounded-0 btn-film-content\" data-toggle=\"modal\" id=\"myModalLateNightAgeWarning\" data-target=\"#myModal17\"></button>\n\n\n<button style=\"display: none;\" class=\"btn btn-outline-dark bg-white rounded-0 btn-film-content\" data-toggle=\"modal\" id=\"myModalCommonButton\" data-target=\"#myModal14\"></button>\n<!-- seat popup 01 -->\n<div class=\"modal modal-new popupscreen\" id=\"screen01\">\n    <div class=\"vertical-alignment-helper\">\n        <div class=\"modal-dialog vertical-align-center\">\n            <div class=\"modal-content\">\n                <!-- Modal body -->\n                <div class=\"modal-body\">\n                    <h4 class=\"modal-new__title\">シアター1</h4>\n                    <div class=\"modal-new__seat\">\n                        <p>334席 +（車椅子6席）</p>\n\n                        <div class=\"seat-area\">\n                            <img src=\"/img/front/images/theater/200/map_01.png\" alt=\"seat\" class=\"img-fluid\">\n                        </div>\n                    </div>\n                    <div class=\"group-button d-flex justify-content-center align-items-center flex-row\">\n                        <a data-dismiss=\"modal\" class=\"btn btn-close\" role=\"button\">閉じる</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<!-- seat popup 02 -->\n<div class=\"modal modal-new popupscreen\" id=\"screen02\">\n    <div class=\"vertical-alignment-helper\">\n        <div class=\"modal-dialog vertical-align-center\">\n            <div class=\"modal-content\">\n                <!-- Modal body -->\n                <div class=\"modal-body\">\n                    <h4 class=\"modal-new__title\">シアター2</h4>\n                    <div class=\"modal-new__seat\">\n                        <p>232席 +（車椅子6席）</p>\n\n                        <div class=\"seat-area\">\n                            <img src=\"/img/front/images/theater/200/map_02.png\" alt=\"seat\" class=\"img-fluid\">\n                        </div>\n                    </div>\n                    <div class=\"group-button d-flex justify-content-center align-items-center flex-row\">\n                        <a data-dismiss=\"modal\" class=\"btn btn-close\" role=\"button\">閉じる</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<!-- seat popup 03 -->\n<div class=\"modal modal-new popupscreen\" id=\"screen03\">\n    <div class=\"vertical-alignment-helper\">\n        <div class=\"modal-dialog vertical-align-center\">\n            <div class=\"modal-content\">\n                <!-- Modal body -->\n                <div class=\"modal-body\">\n                    <h4 class=\"modal-new__title\">シアター3</h4>\n                    <div class=\"modal-new__seat\">\n                        <p>206席 +（車椅子4席）</p>\n\n                        <div class=\"seat-area\">\n                            <img src=\"/img/front/images/theater/200/map_03.png\" alt=\"seat\" class=\"img-fluid\">\n                        </div>\n                    </div>\n                    <div class=\"group-button d-flex justify-content-center align-items-center flex-row\">\n                        <a data-dismiss=\"modal\" class=\"btn btn-close\" role=\"button\">閉じる</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div