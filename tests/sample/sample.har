             <p class=\"mini-map-box js-mini-box mb-0\"></p>\n                            </div>\n                        </div>\n\n                        <!-- Zoom out -->\n                        <i class=\"icon-zoom-out js-zoom-out\"></i>\n                    </div>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"ticket-comment\">\n            <div class=\"container\">\n                <ul class=\"d-flex flex-wrap justify-content-end justify-content-sm-center mb-0\">\n                                        <li class=\"d-flex align-items-center\">\n                        <img class=\"mr-1 img-fluid\" src=\"/img/front/images/seat/icn_type1.png\" alt=\"type seat 1\">\n                        <span>空席</span>\n                    </li>\n                                                            <li class=\"d-flex align-items-center\">\n                        <img class=\"mr-1\" src=\"/img/front/images/seat/icn_type5.png\" alt=\"type 5\">\n                        <span>車椅子スペース（予約不可）</span>\n                    </li>\n                                                            <li class=\"d-flex align-items-center\">\n                        <img class=\"mr-1 img-fluid\" src=\"/img/front/images/seat/icn_type2.png\" alt=\"type seat 2\">\n                        <span class=\"text-link\" data-toggle=\"modal\" data-target=\".pair-sheet-modal\">ペアシート</span>\n                    </li>\n                                                            <li class=\"d-flex align-items-center\">\n                        <img class=\"mr-1 img-fluid\" src=\"/img/front/images/seat/icn_type6.png\" alt=\"type seat 6\">\n                        <span class=\"text-link\" data-toggle=\"modal\" data-target=\".trio-seat-modal\">トリオシート</span>\n                    </li>\n                                                                                                                                                                                                        <li class=\"d-flex align-items-center\">\n                        <img class=\"mr-1 img-fluid\" src=\"/img/front/images/seat/icn_typepeople.png\" alt=\"type seat choosed\">\n                        <span>予約済み</span>\n                    </li>\n                                    </ul>\n            </div>\n        </div>\n    </div>\n    <div class=\"ticket-choose pt-sm-4 px-0\">\n        <div class=\"container\">\n            <ul class=\"js-ticket-choose-list d-flex mb-4 justify-content-start justify-content-center\">\n                <li class=\"ticket-content-img text-center ticket-smock js-ticket-smock\">\n                    <img class=\"img-fluid mb-2\" src=\"/img/front/images/seat/icn_seat_dis.png\" alt=\"\">\n                    <span class=\"seat-no d-block\">未選択</span>\n                </li>\n            </ul>\n\n            <div>\n                <p class=\"mb-0\">※最大で5席までご選択いただけます。ただし、上映回によって異なる場合がございます。</p>\n            </div>\n        </div>\n    </div>\n\n    <div class=\"bg-group-btn ticket-group\">\n\n        <div class=\"btn-list container mb-4 flex-column flex-sm-row-reverse\">\n            <button class=\"btn btn-secondary btn-disabled\" type=\"button\" id=\"seatChoice\">券種選択へ進む</button>\n                            <a class=\"btn btn-primary\" href=\"https://tjoy.jp/t-joy_emiterrace_tokorozawa?date=2026-11-12#film-C4978000\" role=\"button\">上映回選択へ戻る</a>\n                    </div>\n        <div class=\"mx-auto text-center\">\n            <div class=\"container\">\n                <div class=\"accordion-one-item payment-method\">\n                    <div id=\"accordion\">\n                        <div class=\"card\">\n                            <div id=\"unext\">\n                                <p class=\"mb-0 text-left accordion-one-item-ttl\">\n                                    <a class=\"collapsed\" role=\"button\" data-toggle=\"collapse\" href=\"#collapse-unext\"\n                                       aria-expanded=\"false\" aria-controls=\"collapse-unext\">\n                                        選択中の上映回を変更する\n                                    </a>\n                                </p>\n                            </div>\n                            <div id=\"collapse-unext\" class=\"collapse\" data-parent=\"#accordion\" aria-labelledby=\"unext\">\n                                <div class=\"card-body pt-2\" id=\"seat-choice-schedule\">\n                                                                            <div class=\"col-12 flex-ie p-0 mb-0 js-slider-hide\">\n                                            <div class=\"schedule-container js-fixed-schedule js-scroll-wrap mb-4\">\n                                                <ul class=\"calendar-slider pl-0 js-calendar-slider variable-width js-addmore js-scroll-contents\">\n                                                                                                            <li class=\"normal text-center\">\n                                                            <a class=\"calendar-item d-block \" data-date=\"2026-11-11\">\n                                                                <p class=\"font-weight-bold calendar-item-day\">\n                                                                    <small class=\"font-weight-bold\">11/</small>11                                                                    <small class=\"font-weight-bold ml-1\">(水)</small>\n                                                                </p>\n                                                                <p class=\"calendar-item-content d-block mb-0\">\n                                                                                                                                                                                                                        <span class=\"d-block mb-0\">OPEN 8:10</span>\n                                                                                                                                                水曜サービスデー                                                                                                                                    </p>\n                                                            </a>\n                                                        </li>\n                                                                                                            <li class=\"normal text-center\">\n                                                            <a class=\"calendar-item d-block calendar-active\" data-date=\"2026-11-12\">\n                                                                <p class=\"font-weight-bold calendar-item-day\">\n                                                                    <small class=\"font-weight-bold\">11/</small>12                                                                    <small class=\"font-weight-bold ml-1\">(木)</small>\n                                                                </p>\n                                                                <p class=\"calendar-item-content d-block mb-0\">\n                                                                                                                                                                                                                        <span class=\"d-block mb-0\">OPEN 8:10</span>\n                                                                                                                                                KINEZO会員デー                                                                                                                                    </p>\n                                                            </a>\n                                                        </li>\n                                                                                                            <li class=\"normal text-center\">\n                                                            <a class=\"calendar-item d-block \" data-date=\"2026-11-13\">\n                                                                <p class=\"font-weight-bold calendar-item-day\">\n                                                                    <small class=\"font-weight-bold\">11/</small>13                                                                    <small class=\"font-weight-bold ml-1\">(金)</small>\n                                                                </p>\n                                                                <p class=\"calendar-item-content d-block mb-0\">\n                                                                                                                                                                                                                        <span class=\"d-block mb-0\">OPEN 8:00</span>\n                                                                                                                                                                                                                                                                                    </p>\n                                                            </a>\n                                                        </li>\n                                                                                                            <li class=\"normal text-center\">\n                                                            <a class=\"calendar-item d-block \" data-date=\"2026-11-14\">\n                                                                <p class=\"font-weight-bold calendar-item-day\">\n                                                                    <small class=\"font-weight-bold\">11/</small>14                                                                    <small class=\"font-weight-bold ml-1\">(土)</small>\n                                                                </p>\n                                                                <p class=\"calendar-item-content d-block mb-0\">\n                                                                                                                                                                                                                        <span class=\"d-block mb-0\">OPEN 8:10</span>\n                                                                                                                                                                                                                                                                                    </p>\n                                                            </a>\n                                                        </li>\n                                                                                                            <li class=\"normal text-center\">\n                                                            <a class=\"calendar-item d-block \" data-date=\"2026-11-15\">\n                                                                <p class=\"font-weight-bold calendar-item-day\">\n                                                                    <small class=\"font-weight-bold\">11/</small>15                                                                    <small class=\"font-weight-bold ml-1\">(日)</small>\n                                                                </p>\n                                                                <p class=\"calendar-item-content d-block mb-0\">\n                                                                                                                                                                                                                        <span class=\"d-block mb-0\">OPEN 8:10</span>\n                                                                                                                                                                                             