                         <p class=\"font-weight-bold calendar-item-day\">\n                                                                    <small class=\"font-weight-bold\">11/</small>17                                                                    <small class=\"font-weight-bold ml-1\">(火)</small>\n                                                                </p>\n                                                                <p class=\"calendar-item-content d-block mb-0\">\n                                                                                                                                                                                                                        <span class=\"d-block mb-0\">OPEN 8:20</span>\n                                                                                                                                                KINEZO会員デー                                                                                                                                    </p>\n                                                            </a>\n                                                        </li>\n                                                                                                            <li class=\"normal text-center\">\n                                                            <a class=\"calendar-item d-block \" data-date=\"2026-11-18\">\n                                                                <p class=\"font-weight-bold calendar-item-day\">\n                                                                    <small class=\"font-weight-bold\">11/</small>18                                                                    <small class=\"font-weight-bold ml-1\">(水)</small>\n                                                                </p>\n                                                                <p class=\"calendar-item-content d-block mb-0\">\n                       