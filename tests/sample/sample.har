n            </div>\n        </div>\n    </div>\n</div>\n<!-- seat popup 06 -->\n<div class=\"modal modal-new popupscreen\" id=\"screen06\">\n    <div class=\"vertical-alignment-helper\">\n        <div class=\"modal-dialog vertical-align-center\">\n            <div class=\"modal-content\">\n                <!-- Modal body -->\n                <div class=\"modal-body\">\n                    <h4 class=\"modal-new__title\">シアター6</h4>\n                    <div class=\"modal-new__seat\">\n                        <p>85席 +（車椅子2席）</p>\n\n                        <div class=\"seat-area\">\n                            <img src=\"/img/front/images/theater/200/map_06.png\" alt=\"seat\" class=\"img-fluid\">\n                        </div>\n                    </div>\n                    <div class=\"group-button d-flex justify-content-center align-items-center flex-row\">\n                        <a data-dismiss=\"modal\" class=\"btn btn-close\" role=\"button\">閉じる</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<!-- seat popup 07 -->\n<div class=\"modal modal-new popupscreen\" id=\"screen07\">\n    <div class=\"vertical-alignment-helper\">\n        <div class=\"modal-dialog vertical-align-center\">\n            <div class=\"modal-content\">\n                <!-- Modal body -->\n                <div class=\"modal-body\">\n                    <h4 class=\"modal-new__title\">シアター7</h4>\n                    <div class=\"modal-new__seat\">\n                        <p>118席 +（車椅子3席）</p>\n\n                        <div class=\"seat-area\">\n                            <img src=\"/img/front/images/theater/200/map_07.png\" alt=\"seat\" class=\"img-fluid\">\n                        </div>\n                    </div>\n                    <div class=\"group-button d-flex justify-content-center align-items-center flex-row\">\n                        <a data-dismiss=\"modal\" class=\"btn btn-close\" role=\"button\">閉じる</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<!-- seat popup 08 -->\n<div class=\"modal modal-new popupscreen\" id=\"screen08\">\n    <div class=\"vertical-alignment-helper\">\n        <div class=\"modal-dialog vertical-align-center\">\n            <div class=\"modal-content\">\n                <!-- Modal body -->\n                <div class=\"modal-body\">\n                    <h4 class=\"modal-new__title\">シアター8</h4>\n                    <div class=\"modal-new__seat\">\n                        <p>93席 +（車椅子2席）</p>\n\n                        <div class=\"seat-area\">\n                            <img src=\"/img/front/images/theater/200/map_08.png\" alt=\"seat\" class=\"img-fluid\">\n                        </div>\n                    </div>\n                    <div class=\"group-button d-flex justify-content-center align-items-center flex-row\">\n                        <a data-dismiss=\"modal\" class=\"btn btn-close\" role=\"button\">閉じる</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<!-- seat popup 09 -->\n<div class=\"modal modal-new popupscreen\" id=\"screen09\">\n    <div class=\"vertical-alignment-helper\">\n        <div class=\"modal-dialog vertical-align-center\">\n            <div class=\"modal-content\">\n                <!-- Modal body -->\n                <div class=\"modal-body\">\n                    <h4 class=\"modal-new__title\">シアター9</h4>\n                    <div class=\"modal-new__seat\">\n                        <p>76席 +（車椅子2席）</p>\n\n                        <div class=\"seat-area\">\n                            <img src=\"/img/front/images/theater/200/map_09.png\" alt=\"seat\" class=\"img-fluid\">\n                        </div>\n                    </div>\n                    <div class=\"group-button d-flex justify-content-center align-items-center flex-row\">\n                        <a data-dismiss=\"modal\" class=\"btn btn-close\" role=\"button\">閉じる</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<!-- seat popup 10 -->\n<div class=\"modal modal-new popupscreen\" id=\"screen10\">\n    <div class=\"vertical-alignment-helper\">\n        <div class=\"modal-dialog vertical-align-center\">\n            <div class=\"modal-content\">\n                <!-- Modal body -->\n                <div class=\"modal-body\">\n                    <h4 class=\"modal-new__title\">シアター10</h4>\n                    <div class=\"modal-new__seat\">\n                        <p>76席 +（車椅子2席）</p>\n\n                        <div class=\"seat-area\">\n                            <img src=\"/img/front/images/theater/200/map_10.png\" alt=\"seat\" class=\"img-fluid\">\n                        </div>\n                    </div>\n                    <div class=\"group-button d-flex justify-content-center align-items-center flex-row\">\n                        <a data-dismiss=\"modal\" class=\"btn btn-close\" role=\"button\">閉じる</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<!-- seat popup 11 -->\n<div class=\"modal modal-new popupscreen\" id=\"screen11\">\n    <div class=\"vertical-alignment-helper\">\n        <div class=\"modal-dialog vertical-align-center\">\n            <div class=\"modal-content\">\n                <!-- Modal body -->\n                <div class=\"modal-body\">\n                    <h4 class=\"modal-new__title\">シアター11</h4>\n                    <div class=\"modal-new__seat\">\n                        <p>143席 +（車椅子4席）</p>\n\n                        <div class=\"seat-area\">\n                            <img src=\"/img/front/images/theater/200/map_11.png\" alt=\"seat\" class=\"img-fluid\">\n                        </div>\n                    </div>\n                    <div class=\"group-button d-flex justify-content-center align-items-center flex-row\">\n                        <a data-dismiss=\"modal\" class=\"btn btn-close\" role=\"button\">閉じる</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<!-- seat popup 12 -->\n<div class=\"modal modal-new popupscreen\" id=\"screen12\">\n    <div class=\"vertical-alignment-helper\">\n        <div class=\"modal-dialog vertical-align-center\">\n            <div class=\"modal-content\">\n                <!-- Modal body -->\n                <div class=\"modal-body\">\n                    <h4 class=\"modal-new__title\">シアター12</h4>\n                    <div class=\"modal-new__seat\">\n                        <p>155席 +（車椅子4席）</p>\n\n                        <div class=\"seat-area\">\n                            <img src=\"/img/front/images/theater/200/map_12.png\" alt=\"seat\" class=\"img-fluid\">\n                        </div>\n                    </div>\n                    <div class=\"group-button d-flex justify-content-center align-items-center flex-row\">\n                        <a data-dismiss=\"modal\" class=\"btn btn-close\" role=\"button\">閉じる</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n<script type=\"text/javascript\" src=\"https://static.mul-pay.jp/ext/js/token.js\"></script>\n\n\t<script src=\"/js/front/common_func.js?1768975410\"></script>\n\t<script src=\"/js/front/scripts/select-seat.js?1790747507\"></script>\n\n<script src=\"https://static-fe.payments-amazon.com/checkout.js\"></script>\n\n<script>\n    function addOnClick(){\n        $('.schedule-box').each(function () {\n            if($(window).width() <=576){\n                $('.schedule-box-body').removeAttr('onclick');\n            }\n            else {\n                var event = $(this).find('.schedule-status').attr('onclick');\n                $(this).find('.schedule-box-body').attr('onclick',event);\n            }\n        })\n    }\n    $(document).ready(function(){\n        var showDuplicate = false;\n        var showAnotherPayment = false;\n        var showScreenDiff = false;\n        var isMx4dSchedule = false;\n        var isImax3dSchedule = false;\n        var isEvent = false;\n        var sellRoute = false;\n        var lateNightAgeWarning = false;\n        // ITB-73の修正\n        addOnClick();\n        $(window).resize(function () {\n            setTimeout(function(){\n                addOnClick();\n            },1000);\n        })\n\n        // 深夜上映の年齢制限\n        if (lateNightAgeWarning) {\n            $('#myModalLateNightAgeWarning').trigger('click');\n        }\n\n        if (sellRoute) {\n            $('#myModalSellRouteButton').trigger('click');\n            $('#seatChoice').removeAttr('id');\n        } else if (showAnotherPayment) {\n            $('#myModalShowAnotherPaymentButton').trigger('click');\n        } else if (showDuplicate) {\n            $('#myModalShowDuplicateButton').trigger('click');\n        } else if (typeof Multipayment == \"undefined\") { // Multipaymentは使用不明\n            if (isEvent) {\n                $('#myModalTlsEventButton').trigger('click');\n            } else {\n                $('#myModalTlsButton').trigger('click');\n            }\n        }  else if (showScreenDiff) {\n            $('#myModalShowDupScreenButton').trigger('click');\n        }\n\n        // for duplicate pop up show\n        if (typeof Multipayment == \"undefined\") { // Multipaymentは使用不明\n            if (isEvent) {\n                $('#seatChoice').removeAttr('id');\n            }\n        }\n\n        function addChangeSubmit() {\n            $('#seatChoice').addClass('btn-secondary btn-disabled');\n            $('#seatChoice').removeAttr('id');\n            var data = {};\n            data.scheduleId = \"65881\";\n            data.theaterId = \"200\";\n            data.seatArr = $('#seatArr').val() != '' ? JSON.parse($('#seatArr').val()) : [];\n            $.post(\"/reservation/choiceSeatSave\",\n                {\n                    data: JSON.stringify(data),\n                    _csrfToken: $('#csrfToken').val()\n                },\n                function (result) {\n                    result = JSON.parse(result);\n                    if (result.result_code == \"done\") {\n                        // window.location.href = 'https://tjoy.jp/t-joy_emiterrace_tokorozawa/reservation/choice_ticket';\n                        $('#form').submit();\n\n                    }  else if (result.result_code == \"28\") {\n                        window.location.href = 'https://tjoy.jp/t-joy_emiterrace_tokorozawa/timeout';\n                    } else if (result.result_code == \"error\") {\n                        // error\n                        window.location.reload();\n                    }\n                }\n            );\n        }\n\n        var cinemaScheduleGetHtmlApi = false;\n        var here = 'choiceSeat';\n        \n        $(\"[aria-controls='collapse-unext']\").click(function () {\n            if (cinemaScheduleGetHtmlApi === true) {\n                return;\n            }\n\n            var data = {};\n            data.date = \"2026-11-12\";\n            data.theaterId = \"200\";\n            data.event = \"schedule\";\n            data.from = here;\n\n            $.post(\"/theaterTop/cinemaScheduleGetHtmlApi\",\n                {\n                    data: JSON.stringify(data),\n                    _csrfToken: $('#csrfToken').val()\n                },\n                function (result) {\n                    if (false) {\n                        $('#seat-choice-schedule').html(result);\n                    } else {\n                        $('#schedule-tab').html(result);\n                    }\n                    cinemaScheduleGetHtmlApi = true;\n                    // ITB-73\n                    addOnClick();\n                    $(window).resize(function () {\n                        setTimeout(function(){\n                            addOnClick();\n                        },1000);\n                    })\n                }\n            );\n        });\n\n        $(\".calendar-item\").click(function () {\n            var data = {};\n            data.date = $(this).data('date');\n            data.theaterId = \"200\";\n            data.event = \"schedule\";\n            data.from = here;\n            \n            if ($('.calendar-item').hasClass('ajax-loading')) {\n                return;\n            }\n            var nowItem = $(this);\n            nowItem.addClass('ajax-loading');\n\n            $('#schedule-tab').html('');\n\n            $.post(\"/theaterTop/cinemaScheduleGetHtmlApi\",\n                {\n                    data: JSON.stringify(data),\n                    _csrfToken: $('#csrfToken').val()\n                },\n                function (result) {\n                    $('#schedule-tab').html(result);\n                    nowItem.removeClass('ajax-loading');\n                }\n            ).fail(function () {\n                nowItem.removeClass('ajax-loading');\n            });\n\n            //ITB-73\n            setTimeout(function(){\n                addOnClick();\n            },1000);\n            $(window).resize(function () {\n                setTimeout(function(){\n                     addOnClick();\n                },1000);\n            })\n        });\n\n        $('#btn-select-current-schedule').click(function () {\n            $.ajax({\n                url: \"https://tjoy.jp/t-joy_emiterrace_tokorozawa/reservation/cancel_temporary_reservation_which_exists\",\n                method: 'post',\n                dataType: 'json',\n                data: {\n                    _csrfToken: $('meta[name=csrf-token]').attr('content')\n                },\n                success: function (res) {\n                    window.location.reload();\n                },\n                error : function (request, error) {\n                    window.location.reload();\n                }\n            });\n        });\n\n        $('#seatChoice').click(function () {\n            if ($('#seatLength').val() == 0) {\n                return;\n            }\n            $('#addChangeSeatNotes').toggleClass('d-none', true);\n            $('#seatFee').text('***');\n            const needImax3dSeatNotes = isImax3dSchedule && true;\n            \n            if (typeof Multipayment == \"undefined\") { // Multipaymentは使用不明\n                if (isEvent) {\n                    return;\n                } else {\n                    addChangeSubmit();\n                }\n            } else if ($('#seatAddChange').val() > 0) {\n                let fee = $('#seatAddChange').val();\n                let needCounterSeatNotes = false; // Counter seats always cost extra; no separate dialog is needed.\n                let seatArr = $('#seatArr').val() != '' ? JSON.parse($('#seatArr').val()) : [];\n                seatArr.forEach(function (seatId, index) {\n                    if (($('#' + seatId).attr('type-seat') == 14) \n                    && (200 == 200) \n                    && ((04 == '11') || (04 == '12'))) {\n                        needCounterSeatNotes = true;\n                    }\n                });\n                $('#seatFee').text(fee);\n                $('#imax3dSeatNotes').toggleClass('d-none', !needImax3dSeatNotes);\n                $('#counterSeatNotes').toggleClass('d-none', !needCounterSeatNotes);\n                $('#addChangeSeatNotes').toggleClass('d-none', !(needCounterSeatNotes || needImax3dSeatNotes));\n                $('#myModalAddChangeButton').trigger('click');\n                if (isMx4dSchedule) {\n                    $('#mx4dOkButton').toggleClass('seatSubmit', false);\n                    $('#myModal4DButton').trigger('click');\n                }\n            } else if ((parseInt($('#seatLength').val()) + parseInt($('#seatLengthMoney').val())) > 10) {\n                $('#myModalSeat10Button').trigger('click');\n            } else if (isMx4dSchedule) {\n                $('#mx4dOkButton').toggleClass('seatSubmit', true);\n                $('#myModal4DButton').trigger('click');\n            } else if (needImax3dSeatNotes) {\n                $('#imaxOkButton').toggleClass('seatSubmit', true);\n                $('#myModalImaxButton').trigger('click');\n            } else {\n                addChangeSubmit();\n            }\n        });\n\n        $(document).on('click', '.seatSubmit', function () {\n            if ($('#seatLength').val() == 0) {\n                return;\n            }\n            if (typeof Multipayment == \"undefined\") { // Multipaymentは使用不明\n                if (isEvent) {\n                    return;\n                }\n            } else {\n                $(this).prop('disabled', true);\n                addChangeSubmit();\n            }\n        });\n    });\n\n    var _amazonpayinfo = {\"result-code\":\"200\",\"result\":{\"merchantId\":\"A314STVOBVEOG4\",\"signature\":\"JUG+wes0kyvrWJi5Li8xHrCujmGW12z+wpQpYHBdt0rd4bnP+wZI2Xqo9OBgfOjo2+EydLN91\\/TFeJf8Q\\/OXJkue6LU0OA57pFPBFl36O5RrjUuKH2cCLdNQaPzKmzSQ0fTbkAHxj+wILz1eYzK+TvUoSwe1bieqjoF0VcMabGsJCRV1lRIqkKqHeEbXaFCf1hOBRSNz08KF9igDv4RJa\\/rwKOQemT3XhN+1khg65bjRHy510MrnmEbp2xVcpDn6\\/lcIaWrCoT37q4Jsp5V6dQo9vj5EeIWkLOrIZSwVQaMCW6ev6Estsa8b7nw0OGistGdDp+0\\/y4HAx\\/suGn7oYg==\",\"sandbox\":false,\"public_key_id\":\"LIVE-AFO7YH4IQA64UPDYT4BILPN4\",\"region\":\"jp\",\"storeId\":\"amzn1.application-oa2-client.ff2b9739d88247b997f85a4fdfba8e36\"},\"result_datetime\":\"2026-11-11T23:28:26+09:00\"};\n\n    var _payload = '{\"signInReturnUrl\":\"https://tjoy.jp/members/loginAmazon\",\"storeId\":\"amzn1.application-oa2-client.ff2b9739d88247b997f85a4fdfba8e36\",\"signInScopes\":[\"name\", \"email\", \"postalCode\", \"shippingAddress\", \"phoneNumber\"]}';\n\n    // // amazon pay cv2\n    // amazon.Pay.renderButton('#AmazonPayButton', {\n    //     // set checkout environment\n    //     merchantId: _amazonpayinfo[\"result\"][\"merchantId\"],\n    //     ledgerCurrency: 'JPY',\n    //     sandbox: _amazonpayinfo[\"result\"][\"sandbox\"],\n    //     // customize the buyer experience\n    //     checkoutLanguage: 'ja_JP',\n    //     productType: 'SignIn',\n    //     placement: 'Cart',\n    //     buttonColor: 'Gold',\n    //     // configure sign in\n    //     signInConfig: {\n    //         payloadJSON: _payload,\n    //         signature: _amazonpayinfo[\"result\"][\"signature\"],\n    //         publicKeyId: _amazonpayinfo[\"result\"][\"public_key_id\"]\n    //     }\n    // });\n\n    // var w = \"300px\";\n    // var host = document.querySelector('#AmazonPayButton');\n    // var style = document.createElement( 'style' );\n    // style.innerHTML = \".amazonpay-button-container { height: 45px!important;min-height: 45px!important;width: \" + w + \"!important;min-width: \" + w + \"!important;}\";\n    // host.shadowRoot.appendChild( style );\n\n    var init = true;\n    $('#myModal6').on('shown.bs.modal', function (e) {\n        //$(\"#AmazonPayButton\").css('width', w);\n        if (init) {\n            // amazon pay cv2\n            amazon.Pay.renderButton('#AmazonPayButton', {\n                // set checkout environment\n                merchantId: _amazonpayinfo[\"result\"][\"merchantId\"],\n                ledgerCurrency: 'JPY',\n                sandbox: _amazonpayinfo[\"result\"][\"sandbox\"],\n                // customize the buyer experience\n                checkoutLanguage: 'ja_JP',\n                productType: 'SignIn',\n                placement: 'Cart',\n                buttonColor: 'Gold',\n                // configure sign in\n                signInConfig: {\n                    payloadJSON: _payload,\n                    signature: _amazonpayinfo[\"result\"][\"signature\"],\n                    publicKeyId: _amazonpayinfo[\"result\"][\"public_key_id\"]\n                }\n            });\n            init = false;\n        }\n\n    });\n    \n    $(\".agree-banner .btn\").click(function () {\n\n        // alert(this.dataset.agree);\n\n        if (this.dataset.agree == \"\") {\n            $(\".agree-banner\").hide();\n        } else {\n            $.ajax({\n                //url: \"https://tjoy.jp/t-joy_emiterrace_tokorozawa/members/update_consent\",\n                url: \"https://tjoy.jp/t-joy_emiterrace_tokorozawa/members/update_consent\",\n                method: 'post',\n                dataType: 'json',\n                data: {\n                    _csrfToken: $('meta[name=csrf-token]').attr('content'),\n                    consent_status : this.dataset.agree\n                },\n                success: function (res) {\n                    // alert(\"success\");\n                    $(\".agree-banner\").hide();\n                },\n                error : function (request, error) {\n                    // alert(\"error\");\n                    $(\".agree-banner\").hide();\n                }\n            });\n\n        }\n    });\n\n</script>\n\n<!--[/content-wrap]-->\n\n<!--[footer]-->\n<!-- Footer -->\n<footer class=\"page-footer container-fluid\">\n    <div class=\"d-xs-block d-sm-block d-md-none\">\n        <div class=\"icn-social d-flex\">\n                            <div class=\"flex-1\">\n                    <a href=\"https://twitter.com/tjoy_emtt\"\n                       target=\"_blank\" class=\"icn-twitter\">\n                        <img src=\"/img/front/images/icon/icn_x.png?1702344818\" class=\"img-fluid\" width=\"26\" alt=\"\"/>                        <span style=\"margin-left: 15px; font-size: 16px; color: #fff;\" >\n                            劇場公式X                        </span>\n                    </a>\n                </div>\n                    </div>\n    </div>\n\n    <div class=\"footer-bottom text-center\">\n        <div class=\"justify-content-md-center\">\n            <a href=\"https://tjoy.jp/about_company/sitepolicy_foot\" class=\"col-xs-12 col-sm-12 col-12 col-md-auto\" target=\"_blank\">ご利用規約</a>\n            <a href=\"https://help.tjoy.jp\" class=\"col-xs-12 col-sm-12 col-12 col-md-auto\" target=\"_blank\">よくあるご質問</a>\n            <a href=\"https://tjoy.jp/about_company/privacy_policy\" class=\"col-xs-12 col-sm-12 col-12 col-md-auto\" target=\"_blank\">プライバシーポリシー</a>\n            <a href=\"https://tjoy.jp/about_company/commercial_info\" class=\"col-xs-12 col-sm-12 col-12 col-md-auto\" target=\"_blank\">特定商取引法の表記</a>\n            <a href=\"https://tjoy.co.jp\" class=\"col-xs-12 col-sm-12 col-12 col-md-auto\" target=\"_blank\">企業情報</a>\n            <a href=\"https://tjoy-recruit.com\" class=\"col-xs-12 col-sm-12 col-12 col-md-auto\" target=\"_blank\">採用情報</a>\n        </div>\n    </div>\n\n    <!-- Copyright -->\n    <div class=\"footer-copyright text-center\">COPYRIGHT ©TOEI JOY ENTERTAINMENT  ALL RIGHTS RESERVED.\n        <a href=\"javascript:void(0)\" class=\"js-scrollToTop\">\n            <img src=\"/img/front/images/icon/icn_arrow-top_01.png?1574816459\" class=\"icn-arrow-top\" width=\"30\" alt=\"\"/>        </a>\n    </div>\n    <!-- Copyright -->\n    <!-- End footer links -->\n</footer>\n<!-- End footer -->\n<!--[/footer]-->\n</body>\n</html>\n"}}}]}}